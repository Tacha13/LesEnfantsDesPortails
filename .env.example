# Copier ce fichier en .env.docker et compléter les valeurs
# Base de données MySQL
DB_HOST=db
DB_PORT=3306
DB_NAME=les_enfants_des_portails
DB_USER=lep_user
DB_PASSWORD=

# MongoDB
MONGO_URI=mongodb://<utilisateur>:<mot de passe>@mongodb:27017/
MONGO_DB=les_enfants_des_portails
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=

# Application
APP_ENV=development
APP_SECRET=
APP_URL=http://localhost:8090

# Gestion mails - Mailtrap
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

#MariaDB
MARIADB_DATABASE=les_enfants_des_portails
MARIADB_USER=lep_user
MARIADB_PASSWORD=
MARIADB_ROOT_PASSWORD=
